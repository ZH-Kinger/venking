# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# 本地缓存:publish.mjs 克隆的私有 obisidian vault(不入库)
.cache/

# 发布脱敏 denylist:含真实密钥/PII 明文,绝不入库
scripts/.secrets-denylist

# 博客文章源与图片:从私有 obisidian 仓库构建时生成,不入公开仓库(见 scripts/publish.mjs)。
# 公开的 venking 不再存放文章原文;构建/RAG 入库时由 publish.mjs 从私有源拉取生成。
blog/src/posts/
blog/src/.vuepress/public/assets/posts/

# Frontend build output and framework caches
dist/
.astro/
# VuePress 缓存/临时/产物(用 **/ 通配,不锚定具体目录 —— 博客已下沉 blog/src/.vuepress/)
**/.vuepress/.cache/
**/.vuepress/.temp/
**/.vuepress/dist/

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Secrets and machine-local configuration
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
.claude/settings.local.json

# Agent runtime state. Source code and evaluation fixtures remain tracked.
rag-server/data/
rag-server/feedback.jsonl
*.sqlite
*.sqlite3
*.db

# Logs and temporary files
*.log
*.tmp
*.swp
.DS_Store

# Local source snapshots and large knowledge-source imports
_backup_posts_orig/
*.pdf

# 部署目标(含服务器地址,不入公开仓)
scripts/.deploy-target
