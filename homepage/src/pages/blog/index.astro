---
// 博客列表页(/blog/)。与主站统一的深色编辑阅读风。
// 空 collection 时显示精致空态——阶段2 迁入文章后自动填充。
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogNav from "../../components/blog/BlogNav.astro";
import CategorySidebar from "../../components/blog/CategorySidebar.astro";
import Reveal from "../../components/Reveal.astro";
import { getPublishedPosts } from "../../lib/blog";

const posts = await getPublishedPosts();
// 分类去重(用于筛选 chip)
const cats = [...new Set(posts.flatMap((p) => p.data.category ?? []))];
---
<BaseLayout title="博客 · Kinger" theme="dark">
  <BlogNav />
  <div class="hero-band">
    <div class="band-inner">
      <h1>博客</h1>
      <p class="tagline">AIOps 与 AI Infra 实战笔记 · 共 {posts.length} 篇</p>
    </div>
  </div>

  <div class="shell">
    <div class="col-left"><CategorySidebar /></div>
    <div class="page">
    {cats.length > 0 && (
      <div class="filters">
        <button class="chip active" data-cat="__all">全部</button>
        {cats.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="empty reveal">
        <p>文章即将上线</p>
        <span>450+ 篇笔记正在从知识库迁移中,敬请期待。</span>
      </div>
    ) : (
      <ul class="list">
        {posts.map((p, i) => (
          <li class="reveal" data-cats={(p.data.category ?? []).join(",")} style={`--reveal-delay:${Math.min(i, 8) * 50}ms`}>
            <a class="card" href={`/blog/${p.id}/`}>
              <span class="bar" aria-hidden="true"></span>
              <div class="card-body">
                <div class="meta">
                  {p.data.category?.[0] && <span class="cat">{p.data.category[0]}</span>}
                </div>
                <h2>{p.data.title}</h2>
                {p.data.description && <p class="desc">{p.data.description}</p>}
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    </div>
  </div>
  <Reveal />
</BaseLayout>

<style>
  /* 两栏:左分类树 + 右文章列表 */
  .shell {
    display: grid; gap: 40px; grid-template-columns: 240px minmax(0, 1fr);
    max-width: 1160px; margin: 0 auto; padding: 32px 24px 90px;
  }
  .col-left { position: sticky; top: calc(var(--nav-h, 56px) + 24px); align-self: start;
    max-height: calc(100vh - var(--nav-h, 56px) - 48px); overflow-y: auto; }
  @media (max-width: 1080px) {
    .shell { grid-template-columns: minmax(0, 1fr); }
    .col-left { display: none; }
  }

  .hero-band {
    background:
      radial-gradient(ellipse 55% 110% at 12% 0%, rgba(94,106,210,.16), transparent 62%),
      linear-gradient(180deg, rgba(255,255,255,.025), transparent),
      var(--color-void);
    border-bottom: 1px solid var(--color-line);
  }
  .band-inner { max-width: 1160px; margin: 0 auto; padding: 72px 24px 48px; }
  .band-inner h1 {
    margin: 0 0 10px; font-size: clamp(38px, 6vw, 58px); letter-spacing: -.045em;
    line-height: 1; font-weight: 650; color: var(--color-fg);
  }
  .tagline { margin: 0; color: #9ba0aa; font-size: 15px; }

  .page { min-width: 0; }   /* 在 .shell 右栏内占满 */

  /* 分类筛选 chip */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .chip {
    padding: 6px 14px; border-radius: 999px; border: 1px solid #e6e6e9;
    background: rgba(255,255,255,.035); color: #a5a9b2; font-size: 13px; cursor: pointer;
    border-color: var(--color-line-strong);
    transition: border-color .2s ease, color .2s ease, background .2s ease, transform .2s ease;
  }
  .chip:hover { border-color: rgba(245,69,92,.45); color: var(--color-fg); transform: translateY(-1px); }
  .chip.active { background: #d83d55; border-color: #d83d55; color: #fff; }

  .empty {
    text-align: center; padding: 90px 20px;
    border: 1px dashed var(--color-line-strong); border-radius: 16px; color: #8a8f98;
    background: rgba(255,255,255,.025);
  }
  .empty p { margin: 0 0 8px; font-size: 20px; font-weight: 600; color: var(--color-fg); }
  .empty span { font-size: 14px; }

  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .card {
    position: relative;
    display: flex; align-items: center; gap: 12px;
    padding: 20px 22px 20px 24px;
    border-radius: 14px;
    background: rgba(255,255,255,.025); border: 1px solid var(--color-line);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
    text-decoration: none; color: var(--color-fg);
    overflow: hidden;
    transition: transform .25s cubic-bezier(.16,1,.3,1), background .25s ease, border-color .25s ease;
  }
  /* 左侧珊瑚红渐变条:默认藏,hover 滑入 */
  .bar {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: #d83d55;
    transform: scaleY(0); transform-origin: top;
    transition: transform .2s ease;
  }
  .card-body { flex: 1; min-width: 0; }
  .card:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,.055);
    border-color: rgba(255,255,255,.15);
  }
  .card:hover .bar { transform: scaleY(1); }
  .meta { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 13px; color: #8a8f98; }
  .cat { padding: 2px 10px; border-radius: 20px; background: rgb(216 61 85 / 13%); color: #f06a7e; }
  .card h2 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; }
  .desc {
    margin: 8px 0 0; color: #9297a1; font-size: 14px; line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .arrow { flex: 0 0 auto; color: #555b66; font-size: 18px; transition: transform .2s ease, color .2s ease; }
  .card:hover .arrow { transform: translateX(3px); color: #f06a7e; }

  @media (prefers-reduced-motion: reduce) {
    .card, .bar, .arrow, .chip { transition: none; }
    .card:hover { transform: none; }
    .card:hover .bar { transform: scaleY(1); }
  }
</style>

<script>
  // 分类筛选:点 chip 过滤列表项(纯前端,无需重新请求)
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const items = document.querySelectorAll<HTMLLIElement>(".list li");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("active"));
      chip.classList.add("active");
      const cat = chip.dataset.cat;
      items.forEach((li) => {
        const cats = (li.dataset.cats || "").split(",");
        const show = cat === "__all" || cats.includes(cat || "");
        li.style.display = show ? "" : "none";
      });
    });
  });
</script>
