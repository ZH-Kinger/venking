---
// 页脚。文案承接现有博客 footer。
import { SITE } from "../config";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="inner">
    <span>© {year} Kinger · AIOps & AI Infra</span>
    <div class="links">
      <a href="/blog/">博客</a>
      <a href={SITE.yuque} target="_blank" rel="noopener noreferrer">语雀</a>
      {/* ICP 备案号:工信部要求在首页底部展示并链回备案系统,不能改文案/去链接 */}
      <a class="icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{SITE.icp}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding: 28px 24px;
  }
  .inner {
    max-width: 1040px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--color-muted);
    font-size: 13px;
  }
  .links { display: flex; gap: 18px; }
  .links a { color: var(--color-muted); text-decoration: none; transition: color .15s ease; }
  .links a:hover { color: var(--color-fg); }
  @media (prefers-reduced-motion: reduce) { .links a { transition: none; } }
</style>
