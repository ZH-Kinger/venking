---
// 品牌自有图标集(quill):纯线条 currentColor + 统一"羽毛标记",随品牌靛紫,底色随意。
import arrowRight from "../icons/quill/arrow-right.svg?raw";
import book from "../icons/quill/post.svg?raw";
import clipboardText from "../icons/quill/tasks.svg?raw";
import cpu from "../icons/quill/cpu.svg?raw";
import network from "../icons/quill/network.svg?raw";
import robot from "../icons/quill/ai.svg?raw";
import server from "../icons/quill/server.svg?raw";

const icons = {
  "arrow-right": arrowRight,
  book,
  "clipboard-text": clipboardText,
  cpu,
  network,
  robot,
  server,
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
---

<span
  class="icon"
  style={`--icon-size:${size}px`}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={icons[name]}
></span>

<style>
  .icon { display: contents; }
  .icon :global(svg) {
    display: block;
    flex: 0 0 auto;
    width: var(--icon-size);
    height: var(--icon-size);
    stroke-width: 1.8;
  }
</style>
