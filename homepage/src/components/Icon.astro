---
// 官方 Tabler SVG(线性)。内联后继承 currentColor，和博客及 Agent 一致。
import arrowRight from "@tabler/icons/outline/arrow-right.svg?raw";
import book from "@tabler/icons/outline/book.svg?raw";
import clipboardText from "@tabler/icons/outline/clipboard-text.svg?raw";
import cpu from "@tabler/icons/outline/cpu.svg?raw";
import network from "@tabler/icons/outline/network.svg?raw";
import server from "@tabler/icons/outline/server.svg?raw";

// 品牌吉祥物:Kinger 养的绿颊锥尾鹦鹉(单色剪影,长尾为招牌辨识点;眼用深色半透明,
// 白底/靛底皆可读)。取代原 Tabler robot,作为 AI 助手的专属图标(全站自有视觉)。
const parrot = `<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M11.4 13.4 14 12.1l6.2 7.9c.3.4 0 1-.5 1-.2 0-.4-.1-.5-.2L11.3 15Z"/><ellipse cx="9.5" cy="11" rx="3.7" ry="4.4"/><circle cx="9.6" cy="6.3" r="3.4"/><path d="M6.5 5.6c-1.6.1-2.7 1-2.6 2.2.1.9.8 1.3 1.6 1.1-.7-.5-.8-1.4.2-1.8.6-.3 1.4-.4 2-.2Z"/><path d="M8 14.7c0 1 0 1.8-.2 2.6M10.6 14.9c.1 1 .2 1.7.1 2.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" fill="none"/><circle cx="8.3" cy="5.9" r="1.05" fill="rgba(12,14,20,.6)"/></svg>`;

const icons = {
  "arrow-right": arrowRight,
  book,
  "clipboard-text": clipboardText,
  cpu,
  network,
  robot: parrot,
  server,
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
---

<span
  class="icon"
  style={`--icon-size:${size}px`}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={icons[name]}
></span>

<style>
  .icon { display: contents; }
  .icon :global(svg) {
    display: block;
    flex: 0 0 auto;
    width: var(--icon-size);
    height: var(--icon-size);
    stroke-width: 1.8;
  }
</style>
