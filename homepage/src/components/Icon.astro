---
// Lucide 线性图标(MIT,克制统一的"高级简约"线条)。内联后继承 currentColor,全站一致。
import arrowRight from "lucide-static/icons/arrow-right.svg?raw";
import book from "lucide-static/icons/book-open.svg?raw";
import clipboardText from "lucide-static/icons/clipboard-list.svg?raw";
import cpu from "lucide-static/icons/cpu.svg?raw";
import network from "lucide-static/icons/network.svg?raw";
import robot from "lucide-static/icons/bot.svg?raw";
import server from "lucide-static/icons/server.svg?raw";

const icons = {
  "arrow-right": arrowRight,
  book,
  "clipboard-text": clipboardText,
  cpu,
  network,
  robot,
  server,
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
---

<span
  class="icon"
  style={`--icon-size:${size}px`}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={icons[name]}
></span>

<style>
  .icon { display: contents; }
  .icon :global(svg) {
    display: block;
    flex: 0 0 auto;
    width: var(--icon-size);
    height: var(--icon-size);
    stroke-width: 1.8;
  }
</style>
