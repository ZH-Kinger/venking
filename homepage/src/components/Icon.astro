---
// 官方 Tabler SVG(线性)。内联后继承 currentColor，和博客及 Agent 一致。
import arrowRight from "@tabler/icons/outline/arrow-right.svg?raw";
import book from "@tabler/icons/outline/book.svg?raw";
import clipboardText from "@tabler/icons/outline/clipboard-text.svg?raw";
import cpu from "@tabler/icons/outline/cpu.svg?raw";
import network from "@tabler/icons/outline/network.svg?raw";
import server from "@tabler/icons/outline/server.svg?raw";

// 品牌吉祥物：小鹦鹉(填充剪影 + 镂空眼,fill-rule=evenodd 让眼自动透出所在底色)。
// 取代原 Tabler robot,作为 AI 助手的专属图标(全站自有视觉)。
const parrot = `<svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" stroke="none"><path d="M15.6 2.3c.5-.2 1 .2.9.8-.1.7-.5 1.3-1.1 1.7 1.9.7 3.2 2.5 3.4 4.6.6.2 1.1.7 1.3 1.4.1.5-.4.9-.9.7-.4-.1-.7-.4-.8-.8-.2 3-2.3 5.4-5.1 6.2l-.4 1.9c-.1.5-.6.9-1.1.8-.5-.1-.9-.6-.8-1.1l.3-1.4h-.1c-1.2 0-2.3-.3-3.3-.8l-.4 1.7c-.1.5-.6.9-1.1.8-.5-.1-.9-.6-.8-1.1l1.5-6.5C6.1 11.4 5.1 9.8 5.4 8.2c.1-.5.6-.8 1.1-.7l3.7.8C10.4 6 12.4 4 15 3.9c.2-.6.4-1.2.6-1.6Z M14.35 7.1a1.15 1.15 0 1 0-2.3 0 1.15 1.15 0 1 0 2.3 0Z"/></svg>`;

const icons = {
  "arrow-right": arrowRight,
  book,
  "clipboard-text": clipboardText,
  cpu,
  network,
  robot: parrot,
  server,
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
---

<span
  class="icon"
  style={`--icon-size:${size}px`}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={icons[name]}
></span>

<style>
  .icon { display: contents; }
  .icon :global(svg) {
    display: block;
    flex: 0 0 auto;
    width: var(--icon-size);
    height: var(--icon-size);
    stroke-width: 1.8;
  }
</style>
