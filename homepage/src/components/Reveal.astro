---
// 全站滚动揭示 + 交互动效脚本(一次注入,全页复用)。纯原生 JS,零依赖。
// 用法:给任意元素加 class="reveal"(可选 data-reveal-delay="80" 毫秒错峰),
//       进入视口时加 .in 触发 CSS 过渡。
// 另含数字滚动计数(.count[data-to])。动效保持低幅度且尊重 reduced-motion。
---
<style is:global>
  /* —— 滚动揭示 —— */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  .reveal.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // 尊重减弱动画偏好:直接把所有 reveal 显形,不绑任何监听。
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 1) 滚动揭示
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  if (reduce) {
    revealEls.forEach((el) => el.classList.add("in"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add("in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // 2) 数字滚动计数(.count[data-to],进入视口触发一次)
  const counters = document.querySelectorAll<HTMLElement>(".count");
  const runCount = (el: HTMLElement) => {
    const to = Number(el.dataset.to || "0");
    if (reduce) { el.textContent = String(to); return; }
    const dur = 1200, t0 = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);          // easeOutCubic
      el.textContent = String(Math.round(to * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if (counters.length) {
    const cio = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { runCount(e.target as HTMLElement); cio.unobserve(e.target); }
      }
    }, { threshold: 0.6 });
    counters.forEach((el) => cio.observe(el));
  }
</script>
