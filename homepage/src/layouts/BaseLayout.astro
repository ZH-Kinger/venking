---
// 全站基座布局:head/meta/字体/全局 CSS。落地页与博客都基于它。
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** 全站默认深色，保留 light 供独立页面使用。 */
  theme?: "dark" | "light";
}
const {
  title,
  description = "Kinger 的技术博客，记录 AIOps 与 AI Infra 实战",
  theme = "dark",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- favicon:SVG(现代浏览器)+ PNG + ICO 兜底。?v=2 破浏览器强缓存(旧 Vue 图标) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- 语雀图床防盗链:阶段2 迁入的文章插图靠此 meta 才显示(承接现有 VuePress 做法) -->
    <meta name="referrer" content="no-referrer" />

    <!-- Inter 可变字体(Linear 招牌字体) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- KaTeX CSS(数学公式渲染必需;rehype-katex 只出结构,样式靠这个) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  /* 页面级主题底色 */
  :global(html[data-theme="dark"] body) {
    background: var(--color-void);
    color: var(--color-fg);
  }
  :global(html[data-theme="light"] body) {
    background: #ffffff;
    color: #1f1f1f;
  }
</style>
