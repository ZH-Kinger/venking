# Logto 本地开发环境变量(复制为 .env;真实值不提交)。
# 本地默认即可直接用;上生产时改成子域名 + HTTPS。

# 登录/OIDC 端点(影响 OIDC issuer,前端/后端都以此为准)
LOGTO_ENDPOINT=http://localhost:3001
# 管理台端点
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
# 镜像 tag(锁版本可改具体版本号,如 1.x)
LOGTO_TAG=latest

# ---- 生产参考(备案 + HTTPS 后)----
# LOGTO_ENDPOINT=https://auth.venking.tech
# LOGTO_ADMIN_ENDPOINT=https://auth-admin.venking.tech
