# ============================================================
# 复制本文件为 .env,填入真实 key。.env 不进 git。
#   Windows: Copy-Item .env.example .env
# 所有旋钮都可在此覆盖;不填则用 config.py 的默认值。
# ============================================================

# 【必填】API Key(GLM MaaS;embedding/视觉若同账号也用它)
DASHSCOPE_API_KEY=sk-在这里填你的真实key

# ---- 对话大模型(GLM-5.2)----
# LLM_BASE_URL=https://YOUR-MAAS-INSTANCE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=glm-5.2
# TEMPERATURE=0.0            # 打分器/路由确定性

# ---- 向量化 Embedding(专门模型,不能是对话LLM)----
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024         # 锁定,改维度须 kb rebuild
# EMBEDDING_BATCH=10         # 百炼上限

# ---- 视觉(PDF 图 caption;默认试 GLM-5.2,不支持改成 VL 模型)----
# VL_BASE_URL=https://YOUR-MAAS-INSTANCE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# VL_MODEL=glm-5.2

# ---- 重排(用 GLM-5.2 做 LLM 重排)----
# RERANK_MODEL=glm-5.2

# ---- 分块 ----
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80

# ---- 检索 ----
# TOP_K=4                    # 最终喂 LLM 条数
# FETCH_K=20                 # 宽召回(重排前)
# RERANK_TOP_N=4
# SCORE_THRESHOLD=0.3        # 低于此倾向弃答
# MAX_CONTEXT_TOKENS=8000    # 喂 LLM 的上下文 token 预算,超了砍低分块(防爆)
# RRF_K=60                   # RRF 融合平滑常量(混合检索 & RAG-Fusion 共用)
# RAG_FUSION_ENABLED=false   # 多查询融合;默认关,复杂问题自适应触发
# RAG_FUSION_N_QUERIES=3     # 衍生子问题数

# ---- Agent ----
# MAX_RETRIES=1
# RECURSION_LIMIT=15
# RAG_USE_GRAPH=1            # 1=走 M5 LangGraph 图(生产默认);0=M2 单跳基线(仅评测对比用)

# ---- 韧性(M7:超时/重试/降级)----
# LLM_TIMEOUT=60.0           # 单次请求超时(秒)
# LLM_MAX_RETRIES=2          # SDK 内置指数退避重试(仅对 连接/超时/429/5xx)
# 备用 provider(可选):主端点重试耗尽仍失败→切它兜一次;base_url+model 都填才启用,key 留空复用主 key
# FALLBACK_BASE_URL=
# FALLBACK_MODEL=
# FALLBACK_API_KEY=

# ---- 联网搜索 ----
# WEB_PROVIDER=duckduckgo    # duckduckgo(免key) | tavily | bocha
# WEB_MAX_RESULTS=5
# TAVILY_API_KEY=            # WEB_PROVIDER=tavily 时填
# BOCHA_API_KEY=             # WEB_PROVIDER=bocha 时填

# ---- 部署(FastAPI + 自定义前端,当前**无登录**,公开访问)----
# UI_HOST=127.0.0.1          # 本地开发只绑本机;【部署】容器里设 0.0.0.0 才对外(docker-compose 已设)
# UI_PORT=7860
# 注:UI_AUTH_USER/UI_AUTH_PASS 是旧 Gradio 版的登录旋钮,FastAPI 版**不读取**(留存仅兼容 app.py)。

# ---- API 公网防护(FastAPI /api/*;见 security.py)----
# RATE_LIMIT_ENABLED=true    # 按 IP 令牌桶限流(默认开);经 nginx 反代靠 X-Forwarded-For 取真实 IP
# RATE_LIMIT_PER_MIN=30      # 每 IP 每分钟请求上限(也是突发容量);浏览器正常交互远低于此
# API_TOKEN=                 # 填了才校验 ?token= / X-API-Token 头(锁死非浏览器访问);留空=只靠限流

# ---- 检索/路由缓存(见 cache.py)----
# RETRIEVAL_CACHE_ENABLED=true   # 缓存 temp=0 确定性算子(retrieve/classify_route);键含 index_version 自动失效
# RETRIEVAL_CACHE_SIZE=256       # 每个命名缓存 LRU 上限
