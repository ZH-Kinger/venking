# admin-web Logto 接入(复制为 .env 并填真实值;.env 已 gitignore,勿提交)
# Logto 登录端点(自托管本地默认 3001)
VITE_LOGTO_ENDPOINT=http://localhost:3001
# Logto 里建的「SPA 应用」App ID(admin-web 与 AI 前端共用同一个即可)
VITE_LOGTO_APP_ID=
# 后端 API resource 的 indicator(与 rag-server .env 的 LOGTO_API_RESOURCE 一致)
VITE_LOGTO_API_RESOURCE=https://api.venking.tech
