---
// 毛玻璃导航栏。滚动后背景加深(JS 加 .scrolled)——玻璃层是 Linear 招牌之一。
import { SITE } from "../config";
---
<nav id="nav" class="nav">
  <a href="/" class="brand">
    <svg class="mark" viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
      <g stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <line x1="16" y1="20" x2="16" y2="44"/>
        <line x1="16" y1="20" x2="46" y2="16"/>
        <line x1="16" y1="44" x2="46" y2="48"/>
        <line x1="46" y1="16" x2="46" y2="48"/>
        <line x1="16" y1="20" x2="46" y2="48"/>
      </g>
      <g fill="currentColor">
        <circle cx="16" cy="20" r="6"/>
        <circle cx="16" cy="44" r="6"/>
        <circle cx="46" cy="16" r="5.5"/>
        <circle cx="46" cy="48" r="5.5"/>
      </g>
    </svg>
    <span class="name">Kinger</span>
  </a>
  <div class="links">
    <a href="/blog/">博客</a>
    <a href="#features">板块</a>
    <a href={SITE.aiUrl} target="_blank" rel="noopener noreferrer">AI 助手</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    /* 初始透明,滚动后玻璃化 */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background .2s ease, border-color .2s ease, backdrop-filter .2s ease;
  }
  .nav.scrolled {
    background: rgba(8, 9, 10, .6);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--color-line);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--color-fg);
    font-weight: 600;
    letter-spacing: -.01em;
  }
  .mark {
    display: block;
    color: var(--color-accent);
    transition: transform .3s ease;
  }
  .brand:hover .mark { transform: rotate(-8deg) scale(1.08); }
  @media (prefers-reduced-motion: reduce) {
    .mark { transition: none; }
    .brand:hover .mark { transform: none; }
  }
  .links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .links a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 14px;
    transition: color .15s ease;
  }
  .links a:hover { color: var(--color-fg); }

  @media (max-width: 520px) {
    .nav { padding: 12px 16px; }
    .links { gap: 16px; }
    .links a[href="#features"] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav, .links a { transition: none; }
  }
</style>

<script>
  // IntersectionObserver 只在首屏进出视口时切换，不监听每一帧滚动。
  const nav = document.getElementById("nav");
  const hero = document.getElementById("hero");
  if (nav && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => nav.classList.toggle("scrolled", !entry.isIntersecting),
      { rootMargin: "-56px 0px 0px" },
    );
    observer.observe(hero);
  }
</script>
