---
// AI 助手入口区。现在:跳转到 SITE.aiUrl(混合内容策略,https 页不能嵌 http)。
// 备案 + HTTPS 后:改成 iframe 内嵌(留 TODO 注释在下方)。
import { SITE } from "../config";
import Icon from "./Icon.astro";
---
<section class="ai">
  <div class="panel">
    <span class="agent-icon" aria-hidden="true"><Icon name="robot" size={26} /></span>
    <h2>基于本站内容的 AI 助手</h2>
    <p>
      问它博客里的技术问题。有据必给引用，库外会诚实说明，也能帮你写代码和画图。
    </p>
    <a class="btn" href={SITE.aiUrl} target="_blank" rel="noopener noreferrer">
      打开 AI 助手 <Icon name="arrow-right" size={17} />
    </a>
    <!-- TODO(阶段3,备案+HTTPS 后):把上面的跳转按钮换成
         <iframe src="/ai/" title="AI 助手" loading="lazy"></iframe> 内嵌对话框 -->
  </div>
</section>

<style>
  .ai {
    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }
  .panel {
    position: relative;
    text-align: center;
    padding: 56px 32px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 50% 0%, rgba(94,106,210,.16), transparent 60%),
      var(--color-bg-1);
    border: 1px solid var(--color-line);
    overflow: hidden;
  }
  .agent-icon {
    display: grid; place-items: center;
    width: 52px; height: 52px; margin: 0 auto 20px;
    border: 1px solid rgba(94,106,210,.45);
    border-radius: 14px;
    background: var(--color-accent-soft);
    color: #a9b1ec;
  }
  @media (prefers-reduced-motion: no-preference) {
    .agent-icon { animation: agent-breathe 3.2s ease-in-out infinite; }
  }
  @keyframes agent-breathe { 50% { transform: translateY(-4px); border-color: rgba(94,106,210,.75); } }
  .panel h2 {
    margin: 0 0 12px;
    font-size: clamp(24px, 4vw, 34px);
    letter-spacing: -.02em;
    font-weight: 600;
  }
  .panel p {
    margin: 0 auto 28px;
    max-width: 480px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: transform .08s ease, filter .15s ease;
  }
  .btn:hover { filter: brightness(1.1); }
  .btn:active { transform: scale(.97); }

  @media (prefers-reduced-motion: reduce) {
    .agent-icon { animation: none; }
    .btn { transition: none; }
  }
</style>
