---
// 左侧分类导航树。只展开当前分类(details open),其余折叠(点击才展)——避免 451 条全展页面膨胀。
import { getCategoryTree } from "../../lib/blog";

interface Props {
  activeCat?: string;      // 当前分类(高亮 + 默认展开)
  activeId?: string;       // 当前文章 id(高亮)
}
const { activeCat, activeId } = Astro.props;
const tree = await getCategoryTree();
---
<aside class="sidebar">
  <div class="side-title">博文分类</div>
  <nav>
    {tree.map((node) => (
      <details open={node.name === activeCat}>
        <summary>
          <span class="cat-name">{node.name}</span>
          <span class="cat-count">{node.count}</span>
        </summary>
        <ul>
          {node.posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`} class={p.id === activeId ? "active" : ""}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </nav>
</aside>

<style>
  .sidebar { font-size: 14px; }
  .side-title { font-size: 12px; color: #8a8f98; padding: 4px 10px 10px; letter-spacing: .05em; }
  details { border-radius: 8px; }
  summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 10px; border-radius: 8px; cursor: pointer;
    color: #d8dbe0; font-weight: 500; list-style: none; user-select: none;
    transition: background .12s ease;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: "▸"; margin-right: 6px; color: #b0b4bb; font-size: 11px;
    transition: transform .15s ease; display: inline-block;
  }
  details[open] > summary::before { transform: rotate(90deg); }
  summary:hover { background: rgba(255,255,255,.045); }
  .cat-name { flex: 1; }
  .cat-count { font-size: 12px; color: #7e848e; background: rgba(255,255,255,.05); border-radius: 10px; padding: 1px 8px; }
  ul { list-style: none; margin: 2px 0 8px; padding: 0 0 0 8px; }
  li a {
    display: block; padding: 5px 10px; border-radius: 6px;
    color: #858b95; text-decoration: none; font-size: 13.5px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: background .12s ease, color .12s ease;
  }
  li a:hover { background: rgba(255,255,255,.045); color: #e4e6e9; }
  li a.active { background: rgb(216 61 85 / 13%); color: #f06a7e; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) {
    summary, summary::before, li a { transition: none; }
  }
</style>
