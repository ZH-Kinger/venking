---
// 面包屑:首页 > 分类 > 文章标题。
interface Props { category?: string; title: string; }
const { category, title } = Astro.props;
---
<nav class="crumb" aria-label="面包屑">
  <a href="/">首页</a>
  <span class="sep">/</span>
  <a href="/blog/">博客</a>
  {category && (<><span class="sep">/</span><span class="cat">{category}</span></>)}
  <span class="sep">/</span>
  <span class="cur">{title}</span>
</nav>

<style>
  .crumb { font-size: 13px; color: #777d87; margin-bottom: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .crumb a { color: #8a8f98; text-decoration: none; transition: color .12s ease; }
  .crumb a:hover { color: #f06a7e; }
  .sep { color: #444a53; }
  .cat { color: #a2a7b0; }
  .cur { color: #d8dbe0; }
  @media (prefers-reduced-motion: reduce) { .crumb a { transition: none; } }
</style>
