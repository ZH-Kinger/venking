---
// 右栏本文目录。headings 来自 Astro render() 的返回(slug 与 DOM id 一致,含中文,无需 slugify)。
// 只取 h2/h3。空则父组件不渲染本列。
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{toc.length > 0 && (
  <nav class="toc" aria-label="本文目录">
    <div class="toc-title">本文目录</div>
    <ul>
      {toc.map((h) => (
        <li class={h.depth === 3 ? "sub" : ""}>
          <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc { position: sticky; top: calc(var(--nav-h, 56px) + 24px); font-size: 13.5px; }
  .toc-title { font-size: 12px; color: #8a8f98; margin-bottom: 10px; letter-spacing: .05em; }
  ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--color-line); }
  li a {
    display: block; padding: 5px 0 5px 14px; margin-left: -1px;
    border-left: 2px solid transparent;
    color: #8a8f98; text-decoration: none; line-height: 1.5;
    transition: color .12s ease, border-color .12s ease;
  }
  li.sub a { padding-left: 28px; font-size: 13px; }
  li a:hover { color: #e3e5e8; }
  li a.active { color: #f06a7e; border-left-color: #d83d55; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) { li a { transition: none; } }
</style>

<script>
  // scroll-spy:高亮当前可见章节。reduced-motion 下仍高亮(纯颜色变化,非位移),但不加平滑。
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc]")];
  if (links.length) {
    const bySlug = new Map(links.map((a) => [a.dataset.toc!, a]));
    const headings = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    let current: HTMLAnchorElement | null = null;
    const setActive = (slug: string | null) => {
      if (current) current.classList.remove("active");
      const a = slug ? bySlug.get(slug) : null;
      if (a) { a.classList.add("active"); current = a; }
    };
    const io = new IntersectionObserver(
      (entries) => {
        // 取最靠近顶部的可见标题
        const visible = entries.filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: "-10% 0px -70% 0px", threshold: 0 }
    );
    headings.forEach((h) => io.observe(h));
  }
</script>
