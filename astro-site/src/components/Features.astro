---
// 内容板块 Bento grid。板块承接现有博客 + Obsidian vault 真实分类。
import Icon from "./Icon.astro";
const cards = [
  { name: "AI 基础设施", desc: "训练底座、故障排查、NCCL、DCGM、RDMA 与推理优化", n: 195, href: "/blog/category/AI基础设施/", span: "big", icon: "cpu" },
  { name: "AI 大模型", desc: "Agent 应用、RAG、Function Calling 与多智能体协同", n: 108, href: "/blog/category/AI大模型/", span: "big", icon: "robot" },
  { name: "计算机网络", desc: "TCP/IP、Clos、Spine-Leaf、防火墙与网络攻防", n: 64, href: "/blog/category/计算机网络/", span: "", icon: "network" },
  { name: "面试题库", desc: "系统设计、Kubernetes、算法与大厂真题复盘", n: 58, href: "/blog/category/面试/", span: "", icon: "clipboard-text" },
  { name: "运维与云原生", desc: "容器编排、持续交付、监控与高可用部署", n: 47, href: "/blog/category/云原生/", span: "", icon: "server" },
];
---
<section id="features" class="features">
  <div class="head reveal">
    <h2>覆盖的技术板块</h2>
    <p>从底层训练基础设施到上层 Agent 应用,实战为主。</p>
  </div>
  <div class="grid">
    {cards.map((c, i) => (
      <a class={`card reveal ${c.span}`} href={c.href} style={`--reveal-delay:${i * 70}ms`}>
        <div class="card-in">
          <span class="icon"><Icon name={c.icon} size={22} /></span>
          <span class="num">{c.n}<em>篇</em></span>
          <h3>{c.name}</h3>
          <p>{c.desc}</p>
          <span class="arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .features { max-width: 1040px; margin: 0 auto; padding: 100px 24px; }
  .head { text-align: center; margin-bottom: 48px; }
  .head h2 { margin: 0 0 12px; font-size: clamp(28px, 5vw, 42px); letter-spacing: -.02em; font-weight: 600; }
  .head p { margin: 0; color: var(--color-muted); font-size: 16px; }

  .grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .card {
    grid-column: span 2;
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    background: var(--color-bg-1);
    border: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-fg);
  }
  .card.big { grid-column: span 3; }
  .card-in { position: relative; min-height: 178px; padding: 26px; }
  .icon {
    display: grid; place-items: center;
    width: 40px; height: 40px; margin-bottom: 24px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-bg-2);
    color: #a9b1ec;
    transition: transform .3s cubic-bezier(.16,1,.3,1), border-color .2s ease, background .2s ease;
  }
  .num {
    font-size: 30px; font-weight: 700; letter-spacing: -.02em;
    color: var(--color-fg);
  }
  .num em { font-size: 14px; font-style: normal; color: var(--color-muted); margin-left: 4px; }
  .card h3 { margin: 14px 0 8px; font-size: 19px; font-weight: 600; letter-spacing: -.01em; }
  .card p { margin: 0; color: var(--color-muted); font-size: 14px; line-height: 1.6; }
  .arrow {
    position: absolute; top: 26px; right: 24px; color: var(--color-muted);
    transition: transform .15s ease, color .15s ease;
  }
  .card:hover { border-color: var(--color-line-strong); }
  .card:hover .icon { transform: translateY(-3px) rotate(-3deg); border-color: rgba(94,106,210,.5); background: var(--color-accent-soft); }
  .card:hover .arrow { transform: translateX(3px); color: var(--color-accent); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .card, .card.big { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .icon, .arrow { transition: none; }
  }
</style>
