---
// 文章页:三栏深色阅读布局(顶栏 + 左分类树 + 中正文 + 右 TOC)。
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogNav from "../../components/blog/BlogNav.astro";
import CategorySidebar from "../../components/blog/CategorySidebar.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import Breadcrumb from "../../components/blog/Breadcrumb.astro";
import PostNav from "../../components/blog/PostNav.astro";
import { getPublishedPosts, getAdjacentPosts } from "../../lib/blog";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");   // 含 draft:draft 文章页仍可直达
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = post.data.category?.[0];
const { prev, next } = await getAdjacentPosts(post);
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={`${post.data.title} · Kinger`} description={post.data.description} theme="dark">
  <div class="progress" id="progress" aria-hidden="true"></div>
  <BlogNav />
  <div class={`shell ${hasToc ? "has-toc" : ""}`}>
    <div class="col-left"><CategorySidebar activeCat={category} activeId={post.id} /></div>

    <article class="col-main">
      <Breadcrumb category={category} title={post.data.title} />
      <h1>{post.data.title}</h1>
      <div class="meta">
        {post.data.category?.map((c) => <span class="cat">{c}</span>)}
      </div>
      <div class="prose"><Content /></div>
      <PostNav prev={prev} next={next} />
    </article>

    {hasToc && <div class="col-toc"><TableOfContents headings={headings} /></div>}
  </div>
</BaseLayout>

<style>
  .progress { position: fixed; top: 0; left: 0; height: 3px; width: 0%;
    background: #d83d55; z-index: 200; transition: width .1s linear; }

  /* 三栏 grid:左 240 / 中自适应 / 右 200。无 TOC 时降两栏。 */
  .shell {
    display: grid; gap: 40px;
    grid-template-columns: 240px minmax(0, 1fr);
    max-width: 1240px; margin: 0 auto; padding: 32px 24px 96px;
  }
  .shell.has-toc { grid-template-columns: 240px minmax(0, 1fr) 200px; }
  .col-left { position: sticky; top: calc(var(--nav-h, 56px) + 24px); align-self: start; max-height: calc(100vh - var(--nav-h, 56px) - 48px); overflow-y: auto; }
  .col-main { min-width: 0; padding: 32px clamp(22px, 4vw, 54px) 48px; border: 1px solid var(--color-line);
    border-radius: 16px; background: rgba(255,255,255,.022); box-shadow: inset 0 1px 0 rgba(255,255,255,.025); }
  .col-toc { }

  .col-main h1 { margin: 0 0 14px; font-size: clamp(26px, 4vw, 38px); line-height: 1.2; letter-spacing: -.02em; font-weight: 700; }
  .meta { display: flex; align-items: center; gap: 10px; margin-bottom: 36px; font-size: 13px; }
  .cat { padding: 2px 10px; border-radius: 20px; background: rgb(216 61 85 / 13%); color: #f06a7e; }

  /* 窄屏:折叠左右栏,只留正文(移动端侧栏留待抽屉,先隐藏) */
  @media (max-width: 1080px) {
    .shell, .shell.has-toc { grid-template-columns: minmax(0, 1fr); }
    .col-left, .col-toc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .progress { transition: none; } }
</style>

<!-- 正文排版(同前) -->
<style is:global>
  .prose { font-size: 16.5px; line-height: 1.85; color: #c9ccd2; }
  .prose > :first-child { margin-top: 0; }
  .prose p { margin: 1.1em 0; }
  .prose h2 { margin: 1.8em 0 .6em; padding-bottom: .3em; font-size: 26px; color: var(--color-fg); letter-spacing: -.01em; border-bottom: 1px solid var(--color-line); scroll-margin-top: calc(var(--nav-h, 56px) + 20px); }
  .prose h3 { margin: 1.5em 0 .5em; font-size: 21px; color: var(--color-fg); scroll-margin-top: calc(var(--nav-h, 56px) + 20px); }
  .prose h4 { margin: 1.3em 0 .4em; font-size: 17px; color: var(--color-fg); }
  .prose ul, .prose ol { margin: 1em 0; padding-left: 1.5em; }
  .prose li { margin: .4em 0; }
  .prose a { color: #f06a7e; text-decoration: none; border-bottom: 1px solid rgb(240 106 126 / 32%); }
  .prose a:hover { border-bottom-color: #f06a7e; }
  .prose img { max-width: 100%; border-radius: 12px; margin: 1.2em 0; border: 1px solid var(--color-line); box-shadow: 0 18px 50px rgb(0 0 0 / 25%); }
  .prose blockquote { margin: 1.4em 0; padding: .6em 1.2em; border-left: 3px solid #d83d55; background: rgba(255,255,255,.03); border-radius: 0 8px 8px 0; color: #aeb2ba; }
  .prose blockquote p { margin: .4em 0; }
  .prose hr { border: none; border-top: 1px solid var(--color-line); margin: 2em 0; }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 14.5px; }
  .prose th, .prose td { padding: 8px 12px; border: 1px solid var(--color-line); text-align: left; }
  .prose th { background: rgba(255,255,255,.04); color: var(--color-fg); font-weight: 600; }
  .prose :not(pre) > code { background: rgba(255,255,255,.07); padding: .15em .4em; border-radius: 6px; font-family: var(--font-mono); font-size: .88em; color: #f08697; }
  .prose pre.astro-code { margin: 1.4em 0; padding: 16px 18px; border-radius: 12px; overflow-x: auto; font-size: 13.5px; line-height: 1.6; border: 1px solid var(--color-line-strong); background: #0b0d11 !important; }
  .prose pre.astro-code code { font-family: var(--font-mono); background: none; padding: 0; color: inherit; }
  .prose .katex-display { overflow-x: auto; overflow-y: hidden; padding: .4em 0; }
</style>

<script>
  const bar = document.getElementById("progress");
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
